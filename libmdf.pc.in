prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: libmdf
Description: Biblioteca C para emissão de MDF-e (modelo 58)
URL: https://github.com/icaroraci/libmdf
Version: @VERSAO@
Requires: libnfe >= 1.0
Requires.private: libxml-2.0 libcrypto zlib
Cflags: -I${includedir}
Libs: -L${libdir} -lmdf
